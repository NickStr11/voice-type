# VoiceType configuration
# Copy this file to .env and fill in your values.
# .env is gitignored — never commit it.

# Path to your GCP service account JSON key file (REQUIRED)
# Create one at: https://console.cloud.google.com/iam-admin/serviceaccounts
GOOGLE_APPLICATION_CREDENTIALS=/path/to/your/gcp-key.json

# Your GCP project ID (REQUIRED)
# Find it at: https://console.cloud.google.com/home/dashboard
GCP_PROJECT_ID=your-project-id

# Hotkey to toggle recording (optional, default: Ctrl+Alt+R)
# Uses pynput key name format: https://pynput.readthedocs.io/en/latest/keyboard.html
# Examples: <ctrl>+<alt>+r   <ctrl>+<alt>+<space>
# WARNING: Do NOT use Win+key combinations — Windows intercepts them before pynput.
VOICETYPE_HOTKEY=<ctrl>+<alt>+r

# GCP regional endpoint for Chirp 2 STT (optional, default: us-central1)
# Must be one of: us-central1, asia-southeast1, europe-west4
# us-central1 has best latency from Eastern Europe.
VOICETYPE_STT_REGION=us-central1
