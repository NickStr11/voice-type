# VoiceType configuration
# Copy this file to .env and fill in your values.
# .env is gitignored — never commit it.

# ─────────────────────────────────────────────────────────────────────────
# Text cleanup (optional but recommended)
# ─────────────────────────────────────────────────────────────────────────
# VoiceType transcribes locally with Whisper (free, offline). Long dictations
# are then tidied into paragraphs/lists by Gemini. Get a FREE API key at
#   https://aistudio.google.com/apikey
# and paste it below. Only the short transcript is sent for cleanup (never your
# audio), so the free tier covers everyday personal use with room to spare
# (~hundreds of dictations/day; each dictation is a few hundred tokens).
#
# Leave this empty to run fully offline — cleanup then falls back to a fast
# regex pass (punctuation + paragraph splitting, no network, no cost).
GEMINI_API_KEY=

# Hotkey to toggle recording (optional, default: Ctrl+Alt+R)
# Supported combos in the current build:
#   <ctrl>+<alt>+r   <ctrl>+<alt>+v   <ctrl>+<shift>+r   <ctrl>+<shift>+<space>
VOICETYPE_HOTKEY=<ctrl>+<alt>+r

# Whisper model name (local STT)
# Options: large-v3-turbo (fast, ~1.6GB), large-v3 (accurate, ~3GB)
VOICETYPE_WHISPER_MODEL=large-v3-turbo

# Whisper vocabulary bias (optional) — comma-separated jargon you dictate often
# (product names, acronyms, English terms). Whisper conditions on this text, so
# listed words get spelled consistently and survive ru<->en code-switching.
# Keep it under ~350 characters. Leave empty for the neutral default.
# Example: VOICETYPE_WHISPER_PROMPT=MyApp, GitHub, Python, commit, runtime, API
VOICETYPE_WHISPER_PROMPT=

# STT provider: "local" (Whisper, default — free & offline) or "cloud"
# (Google Chirp 3, needs the GCP block below).
VOICETYPE_STT_PROVIDER=local

# ─────────────────────────────────────────────────────────────────────────
# Advanced: Google Cloud (only for cloud STT or Vertex-backed cleanup)
# ─────────────────────────────────────────────────────────────────────────
# Not needed for the default local + GEMINI_API_KEY setup. Set these only if
# you want Chirp cloud STT (VOICETYPE_STT_PROVIDER=cloud) or you prefer to run
# Gemini cleanup through Vertex AI instead of an AI Studio key. When both
# GEMINI_API_KEY and GCP are set, GEMINI_API_KEY wins.
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/your/gcp-key.json
# GCP_PROJECT_ID=your-project-id
# VOICETYPE_STT_REGION=us

# Cypher voice-command planner: "gemini" or "off" (default). Requires GCP
# (Vertex) when enabled. Fast regex command rules work regardless.
VOICETYPE_CYPHER_PLANNER=off
VOICETYPE_CYPHER_PLANNER_MODEL=gemini-2.5-flash
