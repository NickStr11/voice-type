# VoiceType configuration
# Copy this file to .env and fill in your values.
# .env is gitignored — never commit it.

# Path to your GCP service account JSON key file (REQUIRED)
# Create one at: https://console.cloud.google.com/iam-admin/serviceaccounts
GOOGLE_APPLICATION_CREDENTIALS=/path/to/your/gcp-key.json

# Your GCP project ID (REQUIRED)
# Find it at: https://console.cloud.google.com/home/dashboard
GCP_PROJECT_ID=your-project-id

# Hotkey to toggle recording (optional, default: Ctrl+Alt+R)
# Supported combos in the current build:
#   <ctrl>+<alt>+r   <ctrl>+<alt>+v   <ctrl>+<shift>+r   <ctrl>+<shift>+<space>
VOICETYPE_HOTKEY=<ctrl>+<alt>+r

# GCP STT endpoint prefix (optional, default: us for chirp_3)
# Full endpoint format: {prefix}-speech.googleapis.com
VOICETYPE_STT_REGION=us

# STT provider: "cloud" (Google Chirp 3) or "local" (Whisper via faster-whisper)
# Default: cloud. Set to "local" to use local Whisper — no GCP credentials needed.
VOICETYPE_STT_PROVIDER=cloud

# Whisper model name (only used when STT_PROVIDER=local)
# Options: large-v3-turbo (fast, ~1.6GB), large-v3 (accurate, ~3GB)
VOICETYPE_WHISPER_MODEL=large-v3-turbo

# Cypher L2 planner: "gemini" (natural language routing via Gemini) or "off"
# Fast regex rules stay on either way. Planner runs only when "Сайфер" said
# and the deterministic parser didn't understand the command.
# Default if omitted: off.
VOICETYPE_CYPHER_PLANNER=gemini

# Planner model (only used when VOICETYPE_CYPHER_PLANNER=gemini)
VOICETYPE_CYPHER_PLANNER_MODEL=gemini-2.5-flash
